# Non-secret local configuration for the github-sync Edge Function.
# Hosted Supabase injects SUPABASE_URL and the JSON key maps below. For local
# development, use the CLI-provided values or the legacy placeholders.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEYS={"default":"replace-with-local-publishable-key"}
SUPABASE_SECRET_KEYS={"default":"replace-with-local-secret-key"}
# Legacy local fallback names (do not commit real values):
# SUPABASE_ANON_KEY=replace-with-local-anon-key
# SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Comma-separated browser origins. Mobile/server requests may omit Origin.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
